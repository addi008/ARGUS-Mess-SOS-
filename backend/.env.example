# Backend Environment Variables
# Copy this file to .env and fill in real values — NEVER commit .env to git

# MongoDB connection URI (local dev default; replace with Atlas URI for production)
MONGODB_URI=mongodb://localhost:27017/meshsos

# JWT secret — change this to a long random string in production
JWT_SECRET=meshsos_dev_jwt_secret_change_me_in_production

# Port for the main Express API server
PORT=5000

# Port for the mesh simulation relay server
MESH_RELAY_PORT=5001

# Node environment
NODE_ENV=development
